[plugins]
auto_update = false
enabled = [ "noctalia/wallhaven", "noctalia/bitwarden" ]

[plugin_settings."noctalia/wallhaven"]
api_key = "{{.wallhaven_key}}"
download_dir = "/home/{{.chezmoi.username}}/Pictures/wallhaven"
browser_open_near_click = true

[plugin_settings."noctalia/bitwarden"]
clear_clipboard_seconds = 120
login_open_near_click = true
login_placement = "attached"
server_url = "{{.bitwarden_server_url | default "https://vault.bitwarden.com"}}"
unlock_placement = "attached"
